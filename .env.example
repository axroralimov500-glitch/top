# Server
PORT=3000

# Ma'lumotlar bazasi fayli (SQLite, node:sqlite orqali)
DB_PATH=./data/app.db

# JWT imzolash kaliti (ishlab chiqarishda almashtiring!)
JWT_SECRET=dev-jwt-secret-ozgartiring

# Soxta to'lov provayderi callback imzosi uchun kalit
PAYMENT_SECRET=dev-payment-secret-ozgartiring

# Rezerv (qoldiq bandlash) muddati — sekundlarda
RESERVATION_TTL_SECONDS=900

# Muddati o'tgan rezervlarni tozalash intervali — sekundlarda
SWEEP_INTERVAL_SECONDS=30

# Admin IKKINCHI paroli (2-bosqich). Hisob paroli emas: uni users jadvalida
# (seed: devament11). Admin API marshrutlariga faqat shu ikkinchi parol bilan
# olingan token kira oladi.
ADMIN_SECOND_PASSWORD=devament

# 1-bosqichdan keyingi challenge necha sekund yashashi (default 600)
ADMIN_2FA_CHALLENGE_SECONDS=600
