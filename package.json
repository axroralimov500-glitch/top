{
  "name": "ecommerce-ombor-api",
  "version": "1.0.0",
  "description": "Elektron savdo va ombor API — rezerv, tranzaksiya, to'lov callback, rollar",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.mjs\"",
    "test:report": "node scripts/write-test-report.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
